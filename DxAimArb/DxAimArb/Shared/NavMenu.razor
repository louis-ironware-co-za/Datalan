                        <DxTreeViewNode NavigateUrl="wallets" Text="Wallets" Visible=@bAllowedWallets></DxTreeViewNode>
                        <DxTreeViewNode NavigateUrl="markets" Text="Markets" Visible=@bAllowedMarkets></DxTreeViewNode>
                        <DxTreeViewNode NavigateUrl="exchanges" Text="Exchanges" Visible=@bAllowedExchanges></DxTreeViewNode>
                        <DxTreeViewNode NavigateUrl="myaccount" Text="My Account" Visible=@bAllowedMyAccount></DxTreeViewNode>
                        <DxTreeViewNode NavigateUrl="orders" Text="FAQ" Visible=true></DxTreeViewNode>*@
                    </Nodes>
                </DxTreeView>
            </NotAuthorized>

        </AuthorizeView>





        @if (operationInProgress)

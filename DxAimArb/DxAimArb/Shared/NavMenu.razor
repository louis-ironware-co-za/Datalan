@using System.Security.Principal
@inject DxAimArb.Services.Core core
@inject IJSRuntime JS

<div class="sidebar @StateCssClass">
    <AuthorizeView>
        <Authorized>
            <DxTreeView @ref="@TreeView" AllowSelectNodes="true" CssClass="app-sidebar" SelectionChanged="@SelectionChanged">
                <Nodes>
                    <DxTreeViewNode NavigateUrl="./" Text="Employee Rating" Visible=true IconCssClass="btn-icon-profile"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="usermanagement" Text="User Management" Visible=true Enabled=bAdmin IconCssClass="btn-icon-datasource"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="questionsmanagement" Text="Questions" Visible=true Enabled=bAdmin IconCssClass="btn-icon-datasource"></DxTreeViewNode>
                </Nodes>
            </DxTreeView>
        </Authorized>
        <NotAuthorized>
            <DxTreeView @ref="@TreeView" AllowSelectNodes="false" CssClass="app-sidebar" SelectionChanged="@SelectionChanged">
                <Nodes>
                    <DxTreeViewNode NavigateUrl="./" Text="Employee Rating" Visible=false IconCssClass="btn-icon-profile"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="usermanagement" Text="User Management" Visible=false IconCssClass="btn-icon-datasource"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="questionsmanagement" Text="Questions" Visible=false IconCssClass ="btn-icon-datasource"></DxTreeViewNode>
                </Nodes>
            </DxTreeView>
        </NotAuthorized>

    </AuthorizeView>

    @if (operationInProgress)
    {
        <div class="alert-info">Wait...</div>
    }



</div>


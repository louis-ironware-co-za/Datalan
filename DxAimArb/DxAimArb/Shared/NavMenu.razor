@using System.Security.Principal
@inject DxAimArb.Services.Core core


    <div class="sidebar @StateCssClass">
        <AuthorizeView>
            <Authorized>
            <DxTreeView @ref="@TreeView" AllowSelectNodes="true" CssClass="app-sidebar" SelectionChanged="@SelectionChanged">
                <Nodes>
                    <DxTreeViewNode NavigateUrl="./" Text="My Profile" Visible=true IconCssClass="btn-icon-profile"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="index" Text="Overview" IconCssClass="btn-icon-overview"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="trade" Text="Trade" Visible=true IconCssClass ="btn-icon-trade"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="orderbooks" Text="Orderbooks" Visible=true IconCssClass="btn-icon-orderbooks"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="wallets" Text="Wallets" Visible=true IconCssClass="btn-icon-wallets"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="markets" Text="Markets" Visible=true IconCssClass="btn-icon-markets"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="exchanges" Text="Exchanges" Visible=true IconCssClass="btn-icon-exchanges"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="myaccount" Text="My Account" Visible=true IconCssClass="btn-icon-myaccount"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="userprofiles" Text="Data Source" Visible=true IconCssClass="btn-icon-datasource"></DxTreeViewNode>
                </Nodes>
            </DxTreeView>
        </Authorized>
            <NotAuthorized>
                <DxTreeView @ref="@TreeView" AllowSelectNodes="false" CssClass="app-sidebar" SelectionChanged="@SelectionChanged">
                    <Nodes>
                    <DxTreeViewNode NavigateUrl="index" Text="Overview"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="./" Text="My Profile" Visible=true IconCssClass="btn-icon-profile"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="index" Text="Overview" IconCssClass="btn-icon-overview"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="trade" Text="Trade" Visible=true IconCssClass="btn-icon-trade"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="orderbooks" Text="Orderbooks" Visible=true IconCssClass="btn-icon-orderbooks"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="wallets" Text="Wallets" Visible=true IconCssClass="btn-icon-wallets"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="markets" Text="Markets" Visible=true IconCssClass="btn-icon-markets"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="exchanges" Text="Exchanges" Visible=true IconCssClass="btn-icon-exchanges"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="myaccount" Text="My Account" Visible=true IconCssClass="btn-icon-myaccount"></DxTreeViewNode>
                    <DxTreeViewNode NavigateUrl="userprofiles" Text="Data Source" Visible=true IconCssClass="btn-icon-datasource"></DxTreeViewNode>
                </Nodes>
                </DxTreeView>
            </NotAuthorized>

        </AuthorizeView>

        @if (operationInProgress)
        {
            <div class="alert-info">Wait...</div>
        }



    </div>


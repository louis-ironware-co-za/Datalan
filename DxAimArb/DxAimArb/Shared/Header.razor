@code {
    [Parameter] public bool ToggleOn { get; set; }
    [Parameter] public EventCallback<bool> ToggleOnChanged { get; set; }

    async Task OnToggleClick() => await Toggle();

    async Task Toggle(bool? value = null) {
        var newValue = value ?? !ToggleOn;
        if(ToggleOn != newValue) {
            ToggleOn = newValue;
            await ToggleOnChanged.InvokeAsync(ToggleOn);
        }
    }


    //Core 
     void UpdateMessageButtonClicked()
    {
        string msg = "Message Updated At " + DateTime.Now.ToLongTimeString();
        core.UpdateMessage(this, msg);
    }

    private async Task AppState_StateChanged(ComponentBase Source, string Property)
    {
        if (Source != this)
        {
            // Inspect Property to determine if action needs to be taken.
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnInitialized()
    {
        core.StateChanged += async (Source, Property) => await AppState_StateChanged(Source, Property);
    }

    void IDisposable.Dispose()
    {
        core.StateChanged -= async (Source, Property) => await AppState_StateChanged(Source, Property);
    }


}
@page "/usermanagement"

@using DevExpress.Xpo.DB
@using DxAimArb.Data
@using System.Xml.Serialization
@using System.IO.Compression;

@inject IJSRuntime JsRuntime
@inject Core core
@inject UnitOfWork UnitOfWorkUM
@inject NavigationManager NavigationManager
@inject TokenProvider TokenProvider
@inject IJSRuntime JS
@inject IWebHostEnvironment environment

<h2>User List</h2>

@*Show a grid with users*@
@*Id | email | name | surname | Claims*@

@*On select, show the claims that are attached to this user*@
@*In a checklist with the selected claims checked*@

@*Add [Add] [Edit] [Delete] and [Password] buttons*@
@*On Edit User, select the claims type and claim*@

@if (core.IsAdmin())
{
    <AuthorizeView>
        <Authorized Context="auth">
            @if (users == null)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                <div class="my-style-right">
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                      IconCssClass="btn-icon-savewhite"
                      IconPosition="ButtonIconPosition.AfterText"
                      Text="Column Chooser"
                      @onclick="OnClick"
                      CssClass="w-btn-100" />
                </div>

                <p />

                <DxGrid @ref="@Grid"
                Data="@users"
                ShowFilterRow="true"
                ColumnResizeMode="@ColumnResizeMode"
                PageSizeSelectorVisible="true"
                PageSizeSelectorAllRowsItemVisible="true"
                PageSizeSelectorItems="@(new int[] { 5,10,20 })"
                @bind-SelectedDataItems="@SelectedDataItems"
                @bind-SelectedDataItem="SelectedDataItem"
                SelectionMode="GridSelectionMode.Single"
                AllowSelectRowByClick="true"
                KeyFieldName="Id"
                CssClass="mw-1100">
                    <Columns>
                        <DxGridDataColumn Caption="Id" FieldName="Id" />
                        <DxGridDataColumn Caption="Email" FieldName="Email" />
                        <DxGridDataColumn Caption="Name" FieldName="firstName" />
                        <DxGridDataColumn Caption="Surname" FieldName="lastName" />
                        <DxGridDataColumn Caption="Claims" FieldName="Claims" />
                        <DxGridDataColumn Caption="Mobile" FieldName="PhoneNumber" />
                    </Columns>
                </DxGrid>
            }
        </Authorized>


        <NotAuthorized>
            <p><em>(User Management)  @core.notallowedhere</em></p>
        </NotAuthorized>

    </AuthorizeView>
}
else
{
    <p><em>(User Management) @core.notallowedhere</em></p>
}

<DxPopup @bind-Visible="@PopupVisible"
         CloseOnOutsideClick="true"
         ApplyBackgroundShading="true"
         HeaderText="@PopupHeaderText"
         BodyText="@PopupBodyText" />
<style>
     html {  
        height: 100%;  
    }  
    body {  
        min-height: 100%;  
    }   
    .column-chooser-button{
        left:
    }
</style>


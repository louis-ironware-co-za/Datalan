@page "/usermanagement"

@using DevExpress.Xpo.DB
@using DxAimArb.Data
@using System.Xml.Serialization
@using System.IO.Compression;
@using DevExpress.Blazor.Grid;

@inject IJSRuntime JsRuntime
@inject Core core
@inject UnitOfWork UnitOfWorkUM
@inject NavigationManager NavigationManager
@inject TokenProvider TokenProvider
@inject IJSRuntime JS
@inject IWebHostEnvironment environment

<h2>User List</h2>


@if (core.IsAdmin())
{
    <AuthorizeView>
        <Authorized Context="auth">
            @if (users == null)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                          IconCssClass="btn-icon-savewhite"
                          IconPosition="ButtonIconPosition.AfterText"
                          Text="Column Chooser"
                          @onclick="OnClick"
                          CssClass="w-btn-100"
                          Enabled="@(grdEmployees != null)" />
                <p />

                <DxGrid @ref="grdEmployees"
                    Data="@users"
                        KeyFieldName="Oid"
                        PageSize="@users.Count"
                        SelectionMode="GridSelectionMode.Single"
                        AllowSelectRowByClick="true"
                        @bind-SelectedDataItem="SelectedDataItem">
                    <Columns>
                        <DxGridDataColumn Caption="User ID" FieldName="Oid" ReadOnly="true" />
                        <DxGridDataColumn Caption="Email" FieldName="Email" />
                        <DxGridDataColumn Caption="Name" FieldName="Name" />
                        <DxGridDataColumn Caption="Surname" FieldName="Surname" />
                        <DxGridDataColumn Caption="Cellphone" FieldName="Cellphone" />
                    </Columns>
                </DxGrid>

                <div class="grid-actions">
                    <DxButton Text="Edit Selected Row"
                              RenderStyle="ButtonRenderStyle.Primary"
                    @onclick="EditSelectedRow"
                    Enabled="@CanEditRow" />
                    <DxButton Text="Add New Row"
                    RenderStyle="ButtonRenderStyle.Primary"
                    CssClass="grid-action-button"
                    @onclick="AddNewRow" />
                </div>


                <br />

            }
        </Authorized>


        <NotAuthorized>
            <p><em>(User Management)  @core.notallowedhere</em></p>
        </NotAuthorized>

    </AuthorizeView>
}
else
{
    <p><em>(User Management) @core.notallowedhere</em></p>
}


<DxPopup @bind-Visible="PopupVisible"
Title="Edit User Details"
CloseOnOutsideClick="false"
ShowCloseButton="true">
    @if (EditableUser != null)
    {
        <div class="popup-content">
            <div>
                <label for="email">Email:</label>
                <input id="email" type="text" @bind="EditableUser.Email" />
            </div>
            <div>
                <label for="name">Name:</label>
                <input id="name" type="text" @bind="EditableUser.Name" />
            </div>
            <div>
                <label for="surname">Surname:</label>
                <input id="surname" type="text" @bind="EditableUser.Surname" />
            </div>
            <div>
                <label for="cellphone">Cellphone:</label>
                <input id="cellphone" type="text" @bind="EditableUser.Cellphone" />
            </div>
            <DxButton RenderStyle="ButtonRenderStyle.Primary"
            Text="Save Changes"
            @onclick="SaveChanges" />
        </div>
    }
</DxPopup>


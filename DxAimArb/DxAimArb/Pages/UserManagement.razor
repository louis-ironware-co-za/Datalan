    private async void DownloadUserFiles()
    {
        PopupBodyText = SelectedUserName;
        PopupHeaderText = "Downloaded files for";
        PopupVisible = true;

        //get all folders for this user

        //all folders under uploads - not temp and not bidvestfiles
        string rootfolder = Path.Combine(environment.WebRootPath, "uploads");

        string path = Path.Combine(environment.WebRootPath, "uploads\\temp", core.UserId); //destination
        if (!Directory.Exists(path))
        {
            Directory.CreateDirectory(path);
        }
        var zipFile = Path.Combine(path, SelectedUserName + ".zip");
        if (File.Exists(zipFile))
        {
            File.Delete(zipFile);
        }


        string[] subfolders = Directory.GetDirectories(rootfolder);
        using (var archive = ZipFile.Open(zipFile, ZipArchiveMode.Create))
        {
            foreach (string subfolder in subfolders)
            {
                if (subfolder.EndsWith("\\temp")) { }
                else if (subfolder.EndsWith("\\bidvestfiles")) { }
                else
                {

                    string userFolder = subfolder + "\\" + SelectedUserId;
                    if (Directory.Exists(userFolder))
                    {
                        //get all the files in this folder
                        string[] files = Directory.GetFiles(userFolder);

                        foreach (string file in files)
                        {
                            //add it to the zip
                            string? prefix = Path.GetFileName(Path.GetDirectoryName(Path.GetDirectoryName(file)));
                            archive.CreateEntryFromFile(file, prefix + " - " + Path.GetFileName(file));
                        }
                    }
                }
            }
        }

        int i = zipFile.IndexOf("\\uploads");
        string filetodownload = zipFile.Substring(i);
        await JS.InvokeVoidAsync("open", filetodownload, "_blank");
    }

    private string SelectedUserId { get; set; }
    private string SelectedUserName { get; set; }

    //private List<AspNetUsers>? users { get; set; }
    private List<User>? users { get; set; }

    DxGrid? grdEmployees { get; set; }
    private bool PopupVisible { get; set; } = false;
    private string PopupHeaderText { get; set; } = "Header";
    private string PopupBodyText { get; set; } = "Body";

    //private List<AspNetUserClaims>? claims { get; set; }
    private string core_Message { get; set; } = "Loading...";
    private bool boolCanView = true;
    Data.Profile? profile { get; set; }
    private bool CanEditRow => SelectedDataItem is User;

    void OnClick()
    {
        if (grdEmployees != null)
        {
            grdEmployees.ShowColumnChooser("column-chooser");
        }
        else
        {
            PopupBodyText = "Grid is null";
            PopupHeaderText = "Error";
            PopupVisible = true;
        }
    }


    protected override async Task OnInitializedAsync()
    {

        core_Message = "Loading...";
        var authState = await authenticationStateTask;
        core.UpdateMessage(this, "Loading User Management. Please wait...");

        string message = "";

        if (authState != null)
        {
            message = "AuthState != null";

            var user = authState.User;
            if (user?.Identity?.IsAuthenticated == true)
            {
                message += Environment.NewLine + "IsAuthenticated";

                //TODO restore this : boolCanView = (user.FindFirst(c => c.Type == "bAllowedProfile")?.Value.ToLower() == "true");

                if (core.IsAdmin())
                {
                    message += Environment.NewLine + "Can View";
                    if (!UnitOfWorkUM.IsConnected)
                    {
                        core.UpdateMessage(this, "not connected");

                        UnitOfWorkUM.Connect();
                        core.UpdateMessage(this, "now connected: " + UnitOfWorkUM.IsConnected.ToString());

                    }
                    UnitOfWorkUM.Connect();
                    message += Environment.NewLine + "Connected";

                    users = UnitOfWorkUM.Query<Data.User>().ToList(); ; //UnitOfWorkUM.Query<Data.AspNetUsers>().ToList(); //.Where(x => x.Id == core.UserIdGuid).ToList();

                    if (users.Count() == 0)
                    {
                        //user doesn't exist. You shouldn't be here
                        message += Environment.NewLine + "Could not find user";
                    }
                    else
                    {
                        users = UnitOfWorkUM.Query<Data.User>().ToList();
                    }


                }
            }
        }











    }


    private User? EditableUser { get; set; }
    private User? thisUser { get; set; }
    private void AddNewRow()
    {
        var newUser = new User(UnitOfWorkUM) // Provide the required session
            {
                Oid = 0, // Placeholder ID
                Email = string.Empty,
                Name = string.Empty,
                Surname = string.Empty,
                Cellphone = string.Empty
            };

        users?.Add(newUser); // Append the new user to the collection
    }


    private void HandleRowUpdating(User updatedUser)
    {
        UnitOfWorkUM.Save(updatedUser);
        UnitOfWorkUM.CommitChanges();

        Console.WriteLine($"User {updatedUser.Name} updated successfully.");
    }




    private void EditSelectedRow()
    {
        if (SelectedDataItem is User selectedUser)
        {
            EditableUser = selectedUser; // Load the selected user into the popup for editing
            PopupVisible = true; // Open the popup
        }
        else
        {
            Console.WriteLine("No row selected for editing.");
        }
    }
    private void SaveChanges()
    {
        if (EditableUser != null)
        {
            UnitOfWorkUM.Save(EditableUser); // Save changes to the database
            UnitOfWorkUM.CommitChanges(); // Commit the transaction

            PopupVisible = false; // Close the popup
            Console.WriteLine($"Changes saved for user: {EditableUser.Name}");
        }
    }


    private void OnRowUpdating(User updatedUser)
    {
        // Save the updated user
        UnitOfWorkUM.Save(updatedUser); // Persist the changes to the database
        UnitOfWorkUM.CommitChanges();

        Console.WriteLine($"User {updatedUser.Name} updated successfully.");
    }

}


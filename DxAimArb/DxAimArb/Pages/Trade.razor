@inject Core core


@using DxAimArb.Data

@page "/trade"

<PageTitle>AIM Arbitrage @core.latestVer - Trade</PageTitle>



@if (boolCanView)
{
    <AuthorizeView>
        <Authorized>

            <h2>TRADE</h2>

            <p class="pb-2 pt-2 mw-1100">
                This page will be used to trade
            </p>

        </Authorized>
        <NotAuthorized>
            <p><em>(Trade)  @core.notallowedhere</em></p>
        </NotAuthorized>

    </AuthorizeView>
}
else
{
    <p><em>(Trade)  @core.notallowedhere</em></p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }
    private bool boolCanView = false;
    protected override async Task OnInitializedAsync()
    {
        var authState = await authenticationStateTask;
        var user = authState.User;

        //is it admin?
        boolCanView = user.IsInRole("AllowedTrade");

        if (user.Identity.IsAuthenticated)
        {
            core.UpdateMessage(this, user.Identity.Name + " is authenticated. Admin User: " + boolCanView.ToString());
        }
        else
        {
            core.UpdateMessage(this, "The user is NOT authenticated or not logged in\nPlease log in");
        }
    }
   



}
@code {
    #region Cascading Parameters
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationStateTask { get; set; }
    #endregion

    private User? thisUser { get; set; }
    private XPCollection<User>? usersToRate { get; set; }
    private XPCollection<Question>? questions { get; set; }
    private List<Rating>? ratings { get; set; }

    #region Parameters
    private bool boolCanView = true;
    private bool boolCanExport = false;
    private bool DualCitizen { get; set; }
    private string PopupHeaderText { get; set; } = "Information";
    private string PopupBodyText { get; set; } = "Details";
    private List<string> rdOptions = new List<string> { "Yes", "No" };
    private DevExpress.Xpo.XPQuery<Profile>? userprofiles;
    private bool PopupVisible { get; set; } = false;

    #endregion

    protected override async Task OnInitializedAsync()
    {
        //this updates core.Message, which we can show on any page
        //core.UpdateMessage(this, "Profile page load. Start...");

        core.UpdateMessage(this, "Loading Profile data. Please wait...");

        var authState = await authenticationStateTask;
        if (authState != null)
        {
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated == true)
            {

                //TODO restore this : boolCanView = (user.FindFirst(c => c.Type == "bAllowedProfile")?.Value.ToLower() == "true");
                if (boolCanView)
                {

                    if (!UnitOfWork.IsConnected)
                    {
                        core.UpdateMessage(this, "not connected");

                        UnitOfWork.Connect();
                        core.UpdateMessage(this, "connected: " + UnitOfWork.IsConnected.ToString());

                    }
                    UnitOfWork.Connect();

                    var usrs = UnitOfWork.Query<Data.User>().ToList();

                    ratings = UnitOfWork.Query<Data.Rating>().ToList();


                    //get user in users table
                    var qry = UnitOfWork.Query<Data.User>().Where(x => x.Email == user.Identity.Name).ToList();

                    if (qry.Count > 0)
                    {
                        thisUser = qry[0];
                        core.UpdateMessage(this, "User found. UserID: " + core.UserId.ToString());
                    }
                    else
                    {
                        core.UpdateMessage(this, "User " + user.Identity.Name + " not found");
                    }

                    //get the ratings for this user
                    if (thisUser != null)
                    {
                        // Use collections bound to the same session
                        usersToRate = new XPCollection<User>(UnitOfWork);
                        usersToRate.LoadingEnabled = false;
                        questions = new XPCollection<Question>(UnitOfWork);
                        questions.LoadingEnabled = false;

                        // Temporary hashsets to avoid duplicates
                        var distinctUsers = new HashSet<int>();  // HashSet for Colleague Oid (int)
                        var distinctQuestions = new HashSet<int>(); // HashSet for Question Oid (int)

                        // Iterate through the ratings linked to thisUser
                        foreach (Rating rtng in thisUser.Ratings)
                        {
                            // Add distinct Colleague Oid to usersToRate
                            if (!distinctUsers.Contains(rtng.Colleague.Oid))
                            {
                                usersToRate.Add(rtng.Colleague);
                                distinctUsers.Add(rtng.Colleague.Oid);
                            }

                            // Add distinct Question Oid to questions
                            if (!distinctQuestions.Contains(rtng.Question.Oid))
                            {
                                questions.Add(rtng.Question);
                                distinctQuestions.Add(rtng.Question.Oid);
                            }

                            // Debugging: Log Ratings information
                            Console.WriteLine($"RatingValue for RatedUser ({rtng.RatedUser.Name}): {rtng.RatingValue}");
                        }
                    }
                    else
                    {
                        // Optional: Handle the null case, like logging or providing a fallback
                        Console.WriteLine("thisUser is null, no ratings will be queried.");
                    }



                }
                else
                {
                    core.UpdateMessage(this, "Not allowed");
                }
            }
            else
            {
                core.UpdateMessage(this, "User is not authenticated");
            }
        }
        else
        {
            core.UpdateMessage(this, "Auth State is null");
        }



    }

    private async Task SaveRatingValuesAsync(User ratedUser)
    {
        try
        {
            // Perform the saving logic within a Task to simulate asynchronous behavior
            await Task.Run(() =>
            {
                // Filter ratings for the rated user
                var userRatings = ratings
                    .Where(r => r.RatedUser == ratedUser)
                    .GroupBy(r => r.Question.Oid) // Group ratings by unique Question Oid
                    .Select(g => g.First())       // Take the first Rating for each Question
                    .ToList();

                foreach (var rating in userRatings)
                {
                    // Ensure the object is attached to the UnitOfWork
                    UnitOfWork.Save(rating); // Save each rating explicitly
                }

                // Commit all changes to persist updates to the database
                UnitOfWork.CommitChanges();
                Console.WriteLine($"Ratings successfully saved for {ratedUser.Name} {ratedUser.Surname}");
            });

            // Update popup details only after database has been successfully updated
            PopupBodyText = "'Profile' was saved at " + DateTime.Now.ToString();
            PopupHeaderText = "Database Updated";
            PopupVisible = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving ratings: {ex.Message}");
            PopupBodyText = "An error occurred while saving the profile.";
            PopupHeaderText = "Error";
            PopupVisible = true;
        }
    }


}
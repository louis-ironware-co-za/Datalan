    private void getUserDocument(string sourcefilename)
    {
        using (PdfDocumentProcessor source = new PdfDocumentProcessor())
        {
            var sourcepath = environment.WebRootPath + @"\documents\" + sourcefilename;
            source.LoadDocument(sourcepath);
            PdfDocumentFacade documentFacade = source.DocumentFacade;
            PdfAcroFormFacade acroForm = documentFacade.AcroForm;
            PdfFormData formData = source.GetFormData();

            ////string nameslist = "";
            IList<string> names = source.GetFormFieldNames();
            foreach (string name in names)
            {
                if (formData[name].FormFieldType == PdfFormFieldType.Text)
                {
                    formData[name].Value = getUserParameter(name).ToUpper();
                }
                else if (formData[name].FormFieldType == PdfFormFieldType.CheckBox)
                {
                    PdfCheckBoxFormFieldFacade checkboxfield = acroForm.GetCheckBoxFormField(name);
                    //checkboxes
                    if (getUserParameter(name) == "true")
                    {
                        checkboxfield.IsChecked = true;
                    }
                    else
                    {
                        checkboxfield.IsChecked = false;
                    }
                }
            }

            //get the user folder
            var destpath = Path.Combine(environment.WebRootPath, "uploads\\bidvestfiles", core.UserId);
            if (!Directory.Exists(destpath))
            {
                Directory.CreateDirectory(destpath);
            }
            destpath += "\\" + sourcefilename;
            source.SaveDocument(destpath);

            //download the saved one
            JS.InvokeVoidAsync("open", "/uploads/bidvestfiles/" + core.UserId + "/" + sourcefilename, "_blank");

        }

    }

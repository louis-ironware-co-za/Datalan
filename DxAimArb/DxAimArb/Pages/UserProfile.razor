@page "/"

@using DevExpress.Xpo.DB
@using DxAimArb.Data
@using System.Xml.Serialization
@using System.IO.Compression;
@using DevExpress.Xpo; 
@using DevExpress.Pdf;
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Web


@inject IJSRuntime JsRuntime
@inject Core core
@inject UnitOfWork UnitOfWork
@* @inject NavigationManager NavigationManager *@
@* @inject TokenProvider TokenProvider *@
@inject IJSRuntime JS
@inject IWebHostEnvironment environment


<PageTitle>@core.ApplicationName @core.latestVer [Rating]</PageTitle>

@if (boolCanView)
{
    <AuthorizeView>

        <Authorized Context="auth">
           
            @if (usersToRate != null && usersToRate.Any())
            {
                <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                    <blueheader>Please ensure the below information are correct</blueheader>
                </DxFormLayout>

                @foreach (var ratedUser in usersToRate)
                {
                    var userRatings = ratings?
                    .Where(r => r.RatedUser == ratedUser)
                    .GroupBy(r => r.Question.Oid)
                    .Select(g => g.First())
                    .ToList();

                    <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                        <DxFormLayoutGroup Caption="@($"Rate {ratedUser.Name} {ratedUser.Surname}")"
                                           ColSpanXs="12"
                                           ColSpanSm="12"
                                           ColSpanMd="12"
                                           ColSpanLg="12"
                                           ColSpanXl="12"
                                           CssClass="w-100a50">

                            <HeaderTemplate>
                                <div class="header-container">
                                    <div class="my-style">
                                        RATE <b>@ratedUser.Name.ToUpper() @ratedUser.Surname.ToUpper()</b>
                                    </div>
                                    <div class="my-style-right">
                                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                                  IconCssClass="btn-icon-savewhite"
                                                  IconPosition="ButtonIconPosition.AfterText"
                                                  Text="Save"
                                                  @onclick="() => SaveRatingValuesAsync(ratedUser)"
                                                  CssClass="w-btn-100" />
                                    </div>
                                </div>
                            </HeaderTemplate>

                            <Items>
                                @foreach (var rating in userRatings.Select((r, index) => new { Rating = r, Index = index }))
                                {
                                    <DxFormLayoutItem Caption="@($"{rating.Index + 1}. {rating.Rating.Question.QuestionText}")" ColSpanLg="12" ColSpanMd="12">
                                        <RadzenRating @bind-Value="@rating.Rating.RatingValue" Max="5" />
                                    </DxFormLayoutItem>
                                }
                                @if (!userRatings.Any())
                                {
                                    <DxFormLayoutItem Caption="No ratings available for this user" ColSpanLg="12" ColSpanMd="12">
                                        <span>No ratings to display.</span>
                                    </DxFormLayoutItem>
                                }
                            </Items>
                        </DxFormLayoutGroup>
                    </DxFormLayout>
                }
            }
            else
            {
                <div class="page-background-class">
                    <span style="
                                font-size: 36px; /* Make the text larger */
                                font-weight: bold; /* Make the text bold */
                                text-align: center; /* Center the text horizontally */
                                color: blue; /* Set the text color (optional) */
                                position: absolute; /* Enable positioning */
                                top: 50%; /* Center the text vertically */
                                left: 50%; /* Center the text horizontally */
                                transform: translate(-50%, -50%); /* Adjust position to center */
                                z-index: 1; /* Ensure it appears on top */
                                "
                                >No employee listed to rate. Please contact your system administrator.</span>
                </div>

            }

          

            <DxPopup @bind-Visible="@PopupVisible"
            CloseOnOutsideClick="true"
            ApplyBackgroundShading="true"
            HeaderText="@PopupHeaderText"
            BodyText="@PopupBodyText" />



            <div class="footer">
              
                <w-100a50l>@core.Message</w-100a50l>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="page-background-class">
                <h1>Profile</h1>
                <span style="
                                font-size: 36px; /* Make the text larger */
                                font-weight: bold; /* Make the text bold */
                                text-align: center; /* Center the text horizontally */
                                color: blue; /* Set the text color (optional) */
                                position: absolute; /* Enable positioning */
                                top: 50%; /* Center the text vertically */
                                left: 50%; /* Center the text horizontally */
                                transform: translate(-50%, -50%); /* Adjust position to center */
                                z-index: 1; /* Ensure it appears on top */
                                        ">@core.notallowedhere</span>
            </div>
        </NotAuthorized>

    </AuthorizeView>

}
else
{
    <div class="page-background-class">
        <h1>Profile</h1>
        <span style="
                                font-size: 36px; 
                                font-weight: bold;
                                text-align: center; 
                                color: blue; 
                                position: absolute; 
                                top: 50%; 
                                left: 50%; 
                                transform: translate(-50%, -50%); 
                                z-index: 1; 
                                            ">@core.notallowedhere</span>
    </div>
}



    //ProofOfAddress
    string fPOAFileName = "No file selected";
    string POAFileName
    {
        get { return fPOAFileName; }
        set
        {
            fPOAFileName = value;
            //save it
            if (profile != null)
            {
                if (fPOAFileName != "No file selected")
                {
                    // core.UpdateMessage(this, "fPOAFileName != 'No file selected'");
                    if (profile.fileProofOfAddress != fPOAFileName)
                    {
                        // core.UpdateMessage(this, "Setting profile.fileProofOfAddress = '" + fPOAFileName + "'");
                        profile.fileProofOfAddress = fPOAFileName;
                        // core.UpdateMessage(this, "Setting profile.ProofOfAddressType = '" + POATypeValue + "'");
                        profile.ProofOfAddressType = POATypeValue;
                        // core.UpdateMessage(this, "UnitOfWork.CommitChanges();");
                        UnitOfWork.CommitChanges();
                    }
                }

            }
        }
    }
    void OnPOAUploaded(FileUploadEventArgs e)
    {
        POAFileName = e.FileInfo.Name;

    }


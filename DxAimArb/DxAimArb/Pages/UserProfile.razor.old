    //Create an xml dataset of all records in the Profile table
    private async Task SaveUserProfiles()
    {
        userprofiles = UnitOfWork.Query<Profile>();

        //create a dataset
        System.Data.DataSet DS = new System.Data.DataSet();
        DS.DataSetName = "AimDataExport";
        System.Data.DataTable DT = new System.Data.DataTable();
        //add the columns that we need
        DT.Columns.Add("Id", typeof(String));
        DT.Columns.Add("FirstNames", typeof(String));
        DT.Columns.Add("Surname", typeof(String));
        DT.Columns.Add("IDNumber", typeof(String));
        DT.Columns.Add("Email", typeof(String));
        DT.Columns.Add("CallingCode", typeof(String));
        DT.Columns.Add("MobilePhoneNumber", typeof(String));

        //strings
        DT.Columns.Add("Title", typeof(String));
        DT.Columns.Add("Initials", typeof(String));
        DT.Columns.Add("Gender", typeof(String));
        DT.Columns.Add("PostalCode", typeof(String));
        DT.Columns.Add("PreferredName", typeof(String));
        DT.Columns.Add("AccountNumber", typeof(String));
        DT.Columns.Add("AccountType", typeof(String));
        DT.Columns.Add("AddressCity", typeof(String));
        DT.Columns.Add("BankName", typeof(String));
        DT.Columns.Add("IdDocumentType", typeof(String));
        DT.Columns.Add("JobTitle", typeof(String));
        DT.Columns.Add("MonthlyIncome", typeof(String));
        DT.Columns.Add("Occupation", typeof(String));
        DT.Columns.Add("ProofOfAddressType", typeof(String));
        DT.Columns.Add("Province", typeof(String));
        DT.Columns.Add("ReferredBy", typeof(String));
        DT.Columns.Add("TaxNumber", typeof(String));
        DT.Columns.Add("CountryOfBirth", typeof(String));
        DT.Columns.Add("Nationality", typeof(String));
        DT.Columns.Add("AddressLine1", typeof(String));
        DT.Columns.Add("AddressLine2", typeof(String));
        DT.Columns.Add("City", typeof(String));
        DT.Columns.Add("EmployerIndustry", typeof(String));
        DT.Columns.Add("EmployerName", typeof(String));
        DT.Columns.Add("AddressCountry", typeof(String));
        DT.Columns.Add("DualCitizenCountry", typeof(String));
        DT.Columns.Add("fileSelfieWithID", typeof(String));
        DT.Columns.Add("fileIdDocument", typeof(String));
        DT.Columns.Add("fileChequeAccount", typeof(String));
        DT.Columns.Add("fileInheritance", typeof(String));
        DT.Columns.Add("fileInsurancePayout", typeof(String));
        DT.Columns.Add("fileInvestments", typeof(String));
        DT.Columns.Add("fileLoanRepayment", typeof(String));
        DT.Columns.Add("fileNCRLoan", typeof(String));
        DT.Columns.Add("filePrivateCompanyDividend", typeof(String));
        DT.Columns.Add("fileProofOfAddress", typeof(String));
        DT.Columns.Add("fileRetirementAnnuity", typeof(String));
        DT.Columns.Add("fileSaleOfAsset", typeof(String));
        DT.Columns.Add("fileSavings", typeof(String));
        DT.Columns.Add("fileSoleProprietor", typeof(String));
        DT.Columns.Add("fileSpousalDonations", typeof(String));
        DT.Columns.Add("fileTrustDistribution", typeof(String));
        DT.Columns.Add("file1", typeof(String));
        DT.Columns.Add("file2", typeof(String));
        DT.Columns.Add("file3", typeof(String));
        DT.Columns.Add("file4", typeof(String));
        DT.Columns.Add("file5", typeof(String));
        DT.Columns.Add("file6", typeof(String));
        DT.Columns.Add("file7", typeof(String));
        DT.Columns.Add("", typeof(String));

        //bit
        DT.Columns.Add("IsUnemployed", typeof(Boolean));
        DT.Columns.Add("AcceptTerms", typeof(Boolean));
        DT.Columns.Add("DualCitizen", typeof(Boolean));

        //datetime
        DT.Columns.Add("DateOfBirth", typeof(DateTime));
        DT.Columns.Add("SignUpDate", typeof(DateTime));

        //int
        DT.Columns.Add("AnticipatedVolume", typeof(Decimal));
        DT.Columns.Add("TradeSize", typeof(Decimal));


        foreach (Profile user in userprofiles)
        {
            System.Data.DataRow DR = DT.Rows.Add();
            DR["Id"] = user.UserId;
            DR["FirstNames"] = user.FirstNames;
            DR["Surname"] = user.Surname;
            DR["IDNumber"] = user.IDNumber;
            DR["Email"] = user.Email;
            DR["MobilePhoneNumber"] = user.MobilePhoneNumber;
            DR["CallingCode"] = user.CountryDialingCode;
            //strings
            DR["Title"] = user.Title;
            DR["Initials"] = user.Initials;
            DR["Gender"] = user.Gender;
            DR["PostalCode"] = user.PostalCode;
            DR["PreferredName"] = user.PreferredName;
            DR["AccountNumber"] = user.AccountNumber;
            DR["AccountType"] = user.AccountType;
            DR["AddressCity"] = user.AddressCity;
            DR["BankName"] = user.BankName;
            DR["IdDocumentType"] = user.IdDocumentType;
            DR["JobTitle"] = user.JobTitle;
            DR["MonthlyIncome"] = user.MonthlyIncome;
            DR["Occupation"] = user.Occupation;
            DR["ProofOfAddressType"] = user.ProofOfAddressType;
            DR["Province"] = user.Province;
            DR["ReferredBy"] = user.ReferredBy;
            DR["TaxNumber"] = user.TaxNumber;
            DR["CountryOfBirth"] = user.CountryOfBirth;
            DR["Nationality"] = user.Nationality;
            DR["AddressLine1"] = user.AddressLine1;
            DR["AddressLine2"] = user.AddressLine2;
            DR["City"] = user.City;
            DR["EmployerIndustry"] = user.EmployerIndustry;
            DR["EmployerName"] = user.EmployerName;
            DR["AddressCountry"] = user.AddressCountry;
            DR["DualCitizenCountry"] = user.DualCitizenCountry;
            DR["fileSelfieWithID"] = user.fileSelfieWithID;
            DR["fileIdDocument"] = user.fileIdDocument;
            DR["fileChequeAccount"] = user.fileChequeAccount;
            DR["fileInheritance"] = user.fileInheritance;
            DR["fileInsurancePayout"] = user.fileInsurancePayout;
            DR["fileInvestments"] = user.fileInvestments;
            DR["fileLoanRepayment"] = user.fileLoanRepayment;
            DR["fileNCRLoan"] = user.fileNCRLoan;
            DR["filePrivateCompanyDividend"] = user.filePrivateCompanyDividend;
            DR["fileProofOfAddress"] = user.fileProofOfAddress;
            DR["fileRetirementAnnuity"] = user.fileRetrenchmentAnnuity;
            DR["fileSaleOfAsset"] = user.fileSaleOfAsset;
            DR["fileSavings"] = user.fileSavings;
            DR["fileSoleProprietor"] = user.fileSoleProprietor;
            DR["fileSpousalDonations"] = user.fileSpousalDonations;
            DR["fileTrustDistribution"] = user.fileTrustDistribution;
            DR["file1"] = user.file1;
            DR["file2"] = user.file2;
            DR["file3"] = user.file3;
            DR["file4"] = user.file4;
            DR["file5"] = user.file5;
            DR["file6"] = user.file6;
            DR["file7"] = user.file7;

            //bit
            DR["IsUnemployed"] = user.IsUnemployed;
            DR["AcceptTerms"] = user.AcceptTerms;
            DR["DualCitizen"] = user.DualCitizen;

            //datetime
            DR["DateOfBirth"] = user.DateOfBirth;
            DR["SignUpDate"] = user.SignUpDate;

            //int
            DR["AnticipatedVolume"] = (decimal)user.AnticipatedVolume;
            DR["TradeSize"] = (decimal)user.TradeSize;

        }

        //save the schema and the data
        DT.TableName = "tblUserProfile";
        DS.Tables.Add(DT);

        string filename = Guid.NewGuid().ToString();
        string path = Path.Combine(environment.WebRootPath, "uploads\\temp", core.UserId);
        if (!Directory.Exists(path))
        {
            Directory.CreateDirectory(path);
        }

        var filepathXsd = Path.Combine(path, filename + ".xsd");
        var filepathXml = Path.Combine(path, filename + ".xml");

        DS.WriteXmlSchema(filepathXsd);
        DS.WriteXml(filepathXml);

        core.UpdateDataFiles(this, filepathXml, filepathXsd);

        //zip those two
        if (File.Exists(core.xmlFile))
        {
            var zipFile = Path.ChangeExtension(core.xmlFile, "zip");

            using (var archive = ZipFile.Open(zipFile, ZipArchiveMode.Create))
            {
                archive.CreateEntryFromFile(core.xmlFile, Path.GetFileName(core.xmlFile));
                archive.CreateEntryFromFile(core.xsdFile, Path.GetFileName(core.xsdFile));
            }
            File.Delete(core.xmlFile);
            File.Delete(core.xsdFile);

            int i = zipFile.IndexOf("\\uploads");

            string filetodownload = zipFile.Substring(i);
            await JS.InvokeVoidAsync("open", filetodownload, "_blank");

        }


    }

    //Save all fields
    private async Task SaveProfile()
    {
        //save to the db here - probably better to save as you edit? or both?
        if (profile != null)
        {
            profile.Title = TitleValue;
            profile.Initials = InitialsTextValue;
            profile.FirstNames = FirstNamesTextValue;
            profile.Surname = SurnameTextValue;
            profile.PreferredName = PreferrednameTextValue;
            profile.Gender = GenderValue;
            profile.DateOfBirth = this.DateOfBirth;
            profile.CountryOfBirth = CountryName;
            profile.Nationality = NationalityName;
            profile.IDNumber = IDNumberTextValue;
            profile.TaxNumber = TaxNumberTextValue;
            profile.DualCitizen = (YesNoValue == "Yes");
            profile.DualCitizenCountry = TaxLiabilityName;

            profile.Email = EmailTextValue;
            profile.MobilePhoneNumber = MobilePhoneTextValue;
            profile.CountryDialingCode = CountryCodeSelected;
            profile.AddressLine1 = AddressLine1TextValue;
            profile.AddressLine2 = AddressLine2TextValue;
            profile.AddressCity = CityTextValue;
            profile.PostalCode = PostalCodeTextValue;
            profile.Province = ProvinceTextValue;
            profile.AddressCountry = AddressCountryName;

            profile.BankName = BankName;
            profile.AccountNumber = AccountNumber;
            profile.AccountType = AccountTypeValue;
            profile.TradeSize = (int)TradeSizeValue;
            profile.AnticipatedVolume = (int)AnticipatedVolumeValue;

            profile.EmployerName = EmployerNameTextValue;
            profile.EmployerIndustry = IndustrySelected;
            profile.Occupation = Occupation;
            profile.JobTitle = Designation;
            profile.MonthlyIncome = IncomeValue;
            profile.IsUnemployed = Unemployed;

            profile.IdDocumentType = IDTypeName;

            profile.ProofOfAddressType = POATypeName;

            profile.fileSpousalDonations = fSpousalDonationsFileName;

            profile.ReferredBy = ReferredBy;
            await UnitOfWork.CommitChangesAsync();
            PopupBodyText = "'Profile' was saved at " + DateTime.Now.ToString();
            PopupHeaderText = "Database Updated";
            PopupVisible = true;
        }
    }


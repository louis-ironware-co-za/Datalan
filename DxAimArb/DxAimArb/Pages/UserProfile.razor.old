    #region EditValueChanged handlers
    void UnemployedChanged(bool value)
    {
        Employed = !value;

        if (value)
        {

            EmployerNameTextValue = null;
            EmployerIndustry = "Undetermined";
            IndustryValue = "Undetermined";

            Position = Notes = null;
            HireDate = null;
        }
        Unemployed = value;
        StateHasChanged();

    }

    void SelectedDualCitizenChanged(string YesNo)
    {
        ShowCountryOfLiability = (YesNo == "Yes");
    }

    void OnTradeSizeValueChanged(double newValue)
    {
        if (newValue < 100000)
            TradeSizeValue = 100000d;
        else
            TradeSizeValue = newValue;

    }


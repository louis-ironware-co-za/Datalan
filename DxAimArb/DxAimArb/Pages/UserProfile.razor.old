    }

    //Inheritance
    string fInheritanceFileName = "No file selected";
    string InheritanceFileName
    {
        get { return fInheritanceFileName; }
        set
        {
            fInheritanceFileName = value;
            //save it
            if (profile != null)
            {
                //Personal Information
                if (fInheritanceFileName != "No file selected")
                {
                    if (profile.fileInheritance != fInheritanceFileName)
                    {
                        profile.fileInheritance = fInheritanceFileName;
                        UnitOfWork.CommitChanges();
                    }

                }

            }
        }
    }
    void OnInheritanceUploaded(FileUploadEventArgs e)
    {
        InheritanceFileName = e.FileInfo.Name;
    }

    //Insurance Payout
    string fInsurancePayoutFileName = "No file selected";
    string InsurancePayoutFileName
    {
        get { return fInsurancePayoutFileName; }
        set
        {
            fInsurancePayoutFileName = value;
            //save it
            if (profile != null)
            {
                //Personal Information
                if (fInsurancePayoutFileName != "No file selected")
                {
                    if (profile.fileInsurancePayout != fInsurancePayoutFileName)
                    {
                        profile.fileInsurancePayout = fInsurancePayoutFileName;
                        UnitOfWork.CommitChanges();
                    }

                }

            }
        }
    }
    void OnInsuranceUploaded(FileUploadEventArgs e)
    {
        InsurancePayoutFileName = e.FileInfo.Name;
    }

    //Investments
    string fInvestmentsFileName = "No file selected";
    string InvestmentsFileName
    {
        get { return fInvestmentsFileName; }
        set
        {
            fInvestmentsFileName = value;
            //save it
            if (profile != null)
            {
                //Personal Information
                if (fInvestmentsFileName != "No file selected")
                {
                    if (profile.fileInvestments != fInvestmentsFileName)
                    {
                        profile.fileInvestments = fInvestmentsFileName;
                        UnitOfWork.CommitChanges();
                    }

                }

            }
        }
    }
    void OnInvestmentsUploaded(FileUploadEventArgs e)
    {
        InvestmentsFileName = e.FileInfo.Name;
    }

    //Loan Repayment
    string fLoanRepaymentsFileName = "No file selected";
    string LoanRepaymentsFileName
    {
        get { return fLoanRepaymentsFileName; }
        set
        {
            fLoanRepaymentsFileName = value;
            //save it
            if (profile != null)
            {
                if (fLoanRepaymentsFileName != "No file selected")
                {
                    if (profile.fileLoanRepayment != fLoanRepaymentsFileName)
                    {
                        profile.fileLoanRepayment = fLoanRepaymentsFileName;
                        UnitOfWork.CommitChanges();
                    }
                }

            }
        }
    }
    void OnLoanRepaymentsUploaded(FileUploadEventArgs e)
    {
        LoanRepaymentsFileName = e.FileInfo.Name;
    }

    //NCRLoan
    string fNCRLoanFileName = "No file selected";
    string NCRLoanFileName
    {
        get { return fNCRLoanFileName; }
        set
        {
            fNCRLoanFileName = value;
            //save it
            if (profile != null)
            {
                if (fNCRLoanFileName != "No file selected")
                {
                    if (profile.fileNCRLoan != fNCRLoanFileName)
                    {
                        profile.fileNCRLoan = fNCRLoanFileName;
                        UnitOfWork.CommitChanges();
                    }
                }

            }
        }
    }
    void OnNCRLoanUploaded(FileUploadEventArgs e)
    {

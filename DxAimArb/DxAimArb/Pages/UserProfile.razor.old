    }

    //PrivateCompanyDividend
    string fPrivateCompanyDividendFileName = "No file selected";
    string PrivateCompanyDividendFileName
    {
        get { return fPrivateCompanyDividendFileName; }
        set
        {
            fPrivateCompanyDividendFileName = value;
            //save it
            if (profile != null)
            {
                if (fPrivateCompanyDividendFileName != "No file selected")
                {
                    //core.UpdateMessage(this, "fPrivateCompanyDividendFileName != 'No file selected'");
                    if (profile.filePrivateCompanyDividend != fPrivateCompanyDividendFileName)
                    {
                        // core.UpdateMessage(this, "profile.filePrivateCompanyDividend = fPrivateCompanyDividendFileName");
                        profile.filePrivateCompanyDividend = fPrivateCompanyDividendFileName;
                        // core.UpdateMessage(this, "UnitOfWork.CommitChanges();");
                        UnitOfWork.CommitChanges();
                    }
                }

            }
        }

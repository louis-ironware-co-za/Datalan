@page "/profile"
@using DevExpress.Xpo.DB
@using DxAimArb.Data

@inject Core core
@inject UnitOfWork UnitOfWork
@inject NavigationManager NavigationManager

 <PageTitle>AIM Arbitrage - Profile</PageTitle>

@if (boolCanView)
{
    <AuthorizeView>

        <Authorized Context="auth">
            <DxFormLayout CaptionPosition="CaptionPosition.Horizontal" CssClass="w-100">
                <blueheader>Please ensure the below information and documents are correct</blueheader>
            </DxFormLayout>
            @*Personal Information*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="1. Personal Information" ColSpanMd="6" CssClass="my-style">
                     <HeaderTemplate>
                        <div class="my-style">
                            1. Personal Information
                        </div>
                        <div class="my-style-right">
                             <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Update Personal Information" @onclick="SavePersonalInfo" CssClass="w-100" />
                        </div>
                    </HeaderTemplate>
                    <Items>

                   
                    <DxFormLayoutItem Caption="Title" ColSpanLg="2" ColSpanMd="2" CaptionCssClass="required-caption">
                        <DxComboBox Data="@titles"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@TitleSelected"
                                @bind-Text="@TitleValue"
                                AllowUserInput="true"
                                NullText="Select"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Initials" ColSpanLg="2" ColSpanMd="2" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@InitialsTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="Enter Initials"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="First Names" ColSpanLg="5" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@FirstNamesTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="Enter your full First Names as per your Identity Document"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Surname" ColSpanLg="3" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@SurnameTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="Enter your Surname as per your Identity Document"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Preferred name" ColSpanLg="4" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@PreferrednameTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="What do your friends call you?"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Gender" ColSpanLg="2" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxComboBox Data="@genders"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@GenderSelected"
                                @bind-Text="@GenderValue"
                                AllowUserInput="true"
                                NullText="Select"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date of Birth" ColSpanLg="6" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxDateEdit @bind-Date="@DateOfBirth"
                                DisplayFormat="dddd, dd MMMM yyyy"
                                CssClass="cw-320" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Country of Birth" ColSpanLg="6" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                        <DxComboBox Data="@countries_birth"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@CountryValue"
                                @bind-Text="@CountryName"
                                AllowUserInput="false"
                                NullText="Select Country ..."
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Nationality" ColSpanLg="6" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxComboBox Data="@countries_nationality"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@NationalityValue"
                                @bind-Text="@NationalityName"
                                AllowUserInput="false"
                                NullText="Select Country ..."
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="ID Number" ColSpanLg="6" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@IDNumberTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Tax Number" ColSpanLg="6" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@TaxNumberTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                     </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*Contact Details*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="2. Contact Details" ColSpanMd="6" CssClass="my-style">
                    <HeaderTemplate>
                        <div class="my-style">
                            2. Contact Details
                        </div>
                        <div class="my-style-right">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Update Contact Details" @onclick="SaveContactDetails" CssClass="w-100" />
                        </div>
                    </HeaderTemplate>
                    <Items>
                       <DxFormLayoutItem Caption="Email" ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">

                            <DxTextBox @bind-Text="@EmailTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Enter a valid email address"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mobile Phone Number" ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">
                            <DxMaskedInput @bind-Value="@MobilePhoneTextValue"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                       BindValueMode="BindValueMode.OnInput"
                                       Mask="+00 00 000 0000"
                                       NullText="Enter a valid mobile phone number"
                                       CssClass="cw-320"></DxMaskedInput>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Address" ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@AddressLine1TextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Address Line 1"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@AddressLine2TextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Address Line 2"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanLg="8" ColSpanMd="8" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@CityTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="City"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@PostalCodeTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Postal Code"
                                   CssClass="cw-320"> </DxTextBox>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@ProvinceTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Province"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">
                            <DxComboBox Data="@countries"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@AddressCountryTextValue"
                                    @bind-Text="@AddressCountryName"
                                    AllowUserInput="false"
                                    NullText="Select Country ..."
                                    FilteringMode="DataGridFilteringMode.Contains"> </DxComboBox>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*Work Information*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup ColSpanMd="6">
                    <HeaderTemplate>
                        <div class="my-style">
                            3. Work Information

                        </div>
                         <div class="my-style-right">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Update Work Information" @onclick="SaveWorkInformation" CssClass="w-100" />
                        </div>

                    </HeaderTemplate>
                    <Items>
                        <DxFormLayoutItem Caption="Employer Name" ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@EmployerNameTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   CssClass="cw-320"></DxTextBox>
                            <div class="my-style-right">
                                <DxCheckBox CheckedChanged="@((bool t) => UnemployedChanged(t))"
                                        LabelPosition="LabelPosition.Left"
                                        Checked="@Unemployed">Unemployed</DxCheckBox>

                            </div>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Employer Industry" ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxComboBox Data="@industries"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@IndustrySelected"
                                    @bind-Text="@IndustryValue"
                                    AllowUserInput="true"
                                    NullText="Select Industry"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                         <DxFormLayoutItem Caption="Occupation" ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@Occupation"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Job Title" ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@Designation"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Monthly Income" ColSpanLg="3" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                            <DxComboBox Data="@income"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@IncomeSelected"
                                    @bind-Text="@IncomeValue"
                                    AllowUserInput="true"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*Funding Account*@
             <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                 <DxFormLayoutGroup Caption="4. Funding Account" ColSpanMd="6" CssClass="my-style">
                     <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6">
                        <DxMemo 
                            @bind-Text="@FundingAccountLabel"
                            Rows="3"
                            Columns="85"
                            CssClass="w-100a"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"
                        ></DxMemo>
                    </DxFormLayoutItem>
                      <DxFormLayoutItem Caption="Bank Name" ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption" BeginRow="true">
                        <DxComboBox Data="@banks"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@BankValue"
                                @bind-Text="@BankName"
                                AllowUserInput="false"
                                NullText="Select your bank"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                     <DxFormLayoutItem Caption="Account Number" ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@AccountNumber"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                     <DxFormLayoutItem Caption="Account Type" ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption">
                        <DxComboBox Data="@bankaccounttypes"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@AccountTypeValue"
                                @bind-Text="@AccountTypeName"
                                AllowUserInput="false"
                                NullText="Select Account Type"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Trade Size (R100k min)" ColSpanLg="6" ColSpanMd="6" BeginRow="true" CaptionCssClass="required-caption">
                        <DxSpinEdit
                                @bind-Value="@TradeSizeValue"
                                MinValue="100000"
                                Increment="1000"
                                BindValueMode="BindValueMode.OnInput"
                                Mask="@NumericMask.Currency" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Anticipated Volume" ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">
                        <DxSpinEdit
                                @bind-Value="@AnticipatedVolumeValue"
                                MinValue="100000"
                                Increment="1000"
                                BindValueMode="BindValueMode.OnInput"
                                Mask="@NumericMask.Currency" />
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*Identity Document*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="5. ID Document" ColSpanMd="6" CssClass="my-style">
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6">
                        <DxMemo 
                            @bind-Text="@IDDocumentLabel"
                            Rows="3"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"
                        ></DxMemo>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" BeginRow="true">
                        <DxComboBox Data="@iddocuments"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@IDTypeValue"
                                @bind-Text="@IDTypeName"
                                AllowUserInput="false"
                                NullText="Select ID Type"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="2" ColSpanMd="2" BeginRow="true">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadID" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="10" ColSpanMd="10">
                        <bluelabel>@IDDocumentFileName</bluelabel>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>

             @*Selfie with ID*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="6. Selfie with your ID" ColSpanMd="6" CssClass="my-style">
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6">
                        <DxMemo 
                            @bind-Text="@SelfieWithIDLabel"
                            Rows="3"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"
                        ></DxMemo>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="2" ColSpanMd="2" BeginRow="true">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadSelfieWithID" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="10" ColSpanMd="10">
                        <bluelabel>@SelfieWithIDFileName</bluelabel>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>

             @*Proof of Address*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="7. Proof of Address" ColSpanMd="6" CssClass="my-style">
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6">
                        <DxMemo 
                            @bind-Text="@ProofOfAddressLabel"
                            Rows="3"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"
                        ></DxMemo>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" BeginRow="true">
                        <DxComboBox Data="@POAdoctypes"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@POATypeValue"
                                @bind-Text="@POATypeName"
                                AllowUserInput="false"
                                NullText="Select POA Type"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="2" ColSpanMd="2" BeginRow="true">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadPOA" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="10" ColSpanMd="10">
                        <bluelabel>@POAFileName</bluelabel>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*Source of funds*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="8. Source of Funds" ColSpanMd="6" CssClass="my-style">
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6">
                        <DxMemo @bind-Text="@SourceOfFundsLabel"
                            Rows="2"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"></DxMemo>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanLg="3" Caption="Cheque Account" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadChequeAccountStatement" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="9" ColSpanMd="9" Caption=" ">
                        <bluelabel>@ChequeAccountStatementFilename</bluelabel>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6">
                        <DxMemo @bind-Text="@ChequeAccountLabel"
                            Rows="3"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"></DxMemo>
                    </DxFormLayoutItem>

                   

                   
                </DxFormLayoutGroup>


            </DxFormLayout>

            @*Additional Source of Funds*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="@additionalsof" ColSpanMd="6" CssClass="my-style200">
                    <DxFormLayoutItem ColSpanLg="3" ColSpanMd="4">
                        <DxCheckBox @bind-Checked="@ShowInvestments">Investments</DxCheckBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="5" ColSpanMd="4">
                        <DxCheckBox @bind-Checked="@ShowPCD">Private Company Dividend</DxCheckBox>
                    </DxFormLayoutItem>
                     <DxFormLayoutItem ColSpanLg="4" ColSpanMd="4" >
                        <DxCheckBox @bind-Checked="@ShowRetAnn">Retirement Annuity</DxCheckBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem ColSpanLg="3" ColSpanMd="4" BeginRow="true">
                        <DxCheckBox @bind-Checked="@ShowSavings">Savings</DxCheckBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="5" ColSpanMd="4">
                        <DxCheckBox @bind-Checked="@ShowSpousal">Spousal Donations</DxCheckBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="4" ColSpanMd="4">
                        <DxCheckBox @bind-Checked="@ShowTrust">Trust Distribution</DxCheckBox>
                    </DxFormLayoutItem>

                     <DxFormLayoutItem ColSpanLg="3" ColSpanMd="4"  BeginRow="true" >
                        <DxCheckBox @bind-Checked="@ShowInh">Inheritance</DxCheckBox>
                    </DxFormLayoutItem>
                     <DxFormLayoutItem ColSpanLg="5" ColSpanMd="4" >
                        <DxCheckBox @bind-Checked="@ShowSoa">Sale of Asset</DxCheckBox>
                    </DxFormLayoutItem>
                     <DxFormLayoutItem ColSpanLg="4" ColSpanMd="4" >
                        <DxCheckBox @bind-Checked="@ShowLoan">Loan Repayment</DxCheckBox>
                    </DxFormLayoutItem>

                     <DxFormLayoutItem ColSpanLg="3" ColSpanMd="4" BeginRow="true" >
                        <DxCheckBox @bind-Checked="@ShowSoleP">Sole Proprietor</DxCheckBox>
                    </DxFormLayoutItem>
                     <DxFormLayoutItem ColSpanLg="5" ColSpanMd="4" >
                        <DxCheckBox @bind-Checked="@ShowInsPay">Insurance Payout</DxCheckBox>
                    </DxFormLayoutItem>
                     <DxFormLayoutItem ColSpanLg="4" ColSpanMd="4" >
                        <DxCheckBox @bind-Checked="@ShowNCR">NCR Loan (Credit Card/Homeloan/Overdraft)</DxCheckBox>
                    </DxFormLayoutItem>

                    <hr />
                     @*Investments*@
                    <DxFormLayoutItem ColSpanLg="3" Caption="Investments" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption" Visible="@ShowInvestments">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadChequeAccountStatement" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="9" ColSpanMd="9" Caption=" " Visible="@ShowInvestments">
                        <bluelabel>@ChequeAccountStatementFilename</bluelabel>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" Visible="@ShowInvestments">
                        <DxMemo @bind-Text="@ChequeAccountLabel"
                            Rows="3"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"></DxMemo>
                    </DxFormLayoutItem>

                    @*Private Company Dividend*@
                    <DxFormLayoutItem ColSpanLg="3" Caption="Private Company Dividend" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption" Visible="@ShowPCD">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadChequeAccountStatement" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="9" ColSpanMd="9" Caption=" " Visible="@ShowPCD">
                        <bluelabel>@ChequeAccountStatementFilename</bluelabel>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" Visible="@ShowPCD">
                        <DxMemo @bind-Text="@ChequeAccountLabel"
                            Rows="3"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"></DxMemo>
                    </DxFormLayoutItem>

                    @*Retirement Annuity*@
                     <DxFormLayoutItem ColSpanLg="3" Caption="Retirement Annuity" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption" Visible="@ShowRetAnn">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadChequeAccountStatement" CssClass="w-100" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="9" ColSpanMd="9" Caption=" " Visible="@ShowRetAnn">
                        <bluelabel>@ChequeAccountStatementFilename</bluelabel>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" Visible="@ShowRetAnn">
                        <DxMemo @bind-Text="@ChequeAccountLabel"
                            Rows="3"
                            Columns="85"
                            ResizeMode="MemoResizeMode.Disabled"
                            ReadOnly="true"></DxMemo>
                    </DxFormLayoutItem>

                    @*Savings*@
                     <DxFormLayoutItem ColSpanLg="3" Caption="Savings" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption" Visible="@ShowSavings">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Select File" @onclick="UploadChequeAccountStatement" CssClass="w-100" />
                    </DxFormLayoutItem>

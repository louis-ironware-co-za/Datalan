    protected override async void OnInitialized()
    {
        //this updates core.Message, which we can show on any page
        //core.UpdateMessage(this, "Profile page load. Start...");

      
        var authState = await authenticationStateTask;
        if (authState != null)
        {
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated == true)
            {
                //TODO restore this : boolCanView = (user.FindFirst(c => c.Type == "bAllowedProfile")?.Value.ToLower() == "true");
                if (boolCanView)
                {
                    if (!UnitOfWork.IsConnected)
                    {
                        UnitOfWork.Connect();
                    }

                    //TODO - always only return what this user can see
                    //orders = UnitOfWork.Query<Order>().Where(x => x.Customer.Oid == user.Identity.Oid);

                    //get a unique list of industries sorted by name
                    industries = (from Name in UnitOfWork.Query<Industry>()
                    .Select(s => s.Name)
                    .Distinct() as XPQuery<string>
                                  orderby Name ascending
                                  select Name).ToList();

                    //get or add the profile record for this user
                    FirstNamesTextValue = core.FirstName?.Replace("$", "");
                    SurnameTextValue = core.LastName?.Replace("$", "");
                    EmailTextValue = core.Email?.Replace("$", "");
                    InitialsTextValue = FirstNamesTextValue?.Substring(0, 1);

                    //get/create the Profile for this user

                    var qry = UnitOfWork.Query<Data.Profile>().Where(x => x.UserId == core.UserId);

                    if (qry == null)
                    {
                        //create one for this user
                        profile = new Data.Profile(UnitOfWork);
                        profile.UserId = core.UserId;
                        profile.FirstNames = FirstNamesTextValue;
                        profile.PreferredName = FirstNamesTextValue;
                        profile.Surname = SurnameTextValue;
                        UnitOfWork.CommitChanges();
                    }
                    else
                    {
                        //it exists. Just use it and set all text field values from the db table
                        profile = qry.FirstOrDefault();
                        //profile.Surname = SurnameTextValue;
                        //UnitOfWork.CommitChanges();




                        if (profile != null)
                        {
                            core.UpdateMessage(this, "Profile found. Loading Personal Information");
                            //1. Personal Information
                            TitleValue = profile.Title;
                            InitialsTextValue = profile.Initials;
                            FirstNamesTextValue = profile.FirstNames;
                            SurnameTextValue = profile.Surname;
                            PreferrednameTextValue = profile.PreferredName;
                            GenderValue = profile.Gender;
                            this.DateOfBirth = profile.DateOfBirth;
                            CountryName = profile.CountryOfBirth;
                            NationalityName = profile.Nationality;
                            IDNumberTextValue = profile.IDNumber;
                            TaxNumberTextValue = profile.TaxNumber;
                            DualCitizen = profile.DualCitizen;

                            core.UpdateMessage(this, "Profile found. Loading Contact Details");
                            //2. Contact details
                            EmailTextValue = profile.Email;
                            MobilePhoneTextValue = profile.MobilePhoneNumber;
                            AddressLine1TextValue = profile.AddressLine1;
                            AddressLine2TextValue = profile.AddressLine2;
                            CityTextValue = profile.AddressCity;
                            PostalCodeTextValue = profile.PostalCode;
                            ProvinceTextValue = profile.Province;
                            AddressCountryTextValue = profile.AddressCountry;

                            core.UpdateMessage(this, "Profile found. Loading Work Information");
                            //3. Work information
                            EmployerNameTextValue = profile.EmployerName;
                            IndustrySelected = profile.EmployerIndustry;
                            EmployerIndustry = profile.EmployerIndustry;
                            IndustryValue = profile.EmployerIndustry;
                            Occupation = profile.Occupation;
                            Designation = profile.JobTitle;
                            IncomeValue = profile.MonthlyIncome;

                            core.UpdateMessage(this, "Profile found. Loading Funding Account");
                            //4. Funding Account
                            BankName = profile.BankName;
                            AccountNumber = profile.AccountNumber;
                            AccountTypeValue = profile.AccountType;
                            TradeSizeValue = (double)profile.TradeSize;
                            AnticipatedVolumeValue = (double)profile.AnticipatedVolume;

                            core.UpdateMessage(this, "Profile found. Loading ID Doc Type");

                            //5. ID Document
                            IDTypeName = profile.IdDocumentType;

                            //7. Proof of Address
                            POATypeName =  profile.ProofOfAddressType;
                            POATypeValue = profile.ProofOfAddressType;

                            core.UpdateMessage(this, "Profile found. Loading Referred By");
                            ReferredBy = profile.ReferredBy;

                            core.UpdateMessage(this, "Profile found. Loading Ts and Cs");
                            AcceptTandC = profile.AcceptTerms;

                            //file uploads === 5 ==============================================================
                            core.UpdateMessage(this, "Profile found. Selfie with ID file");
                            if (String.IsNullOrWhiteSpace(profile.fileSelfieWithID))
                                SelfieWithIDFileName = "No file selected";
                            else
                                SelfieWithIDFileName = profile.fileSelfieWithID;

                            core.UpdateMessage(this, "Profile found. Loading ID Document file");
                            if (String.IsNullOrWhiteSpace(profile.fileIdDocument))
                                IdDocumentFileName = "No file selected";
                            else
                                IdDocumentFileName = profile.fileIdDocument;

                            core.UpdateMessage(this, "Profile found. Loading Cheque Account file");
                            if (String.IsNullOrWhiteSpace(profile.fileChequeAccount))
                                ChequeAccountStatementFilename = "No file selected";
                            else
                                ChequeAccountStatementFilename = profile.fileChequeAccount;

                            core.UpdateMessage(this, "Profile found. Loading Inheritance file");
                            if (String.IsNullOrWhiteSpace(profile.fileInheritance))
                                InheritanceFileName = "No file selected";
                            else
                                InheritanceFileName = profile.fileInheritance;

                            core.UpdateMessage(this, "Profile found. Loading Insurance Payout file");
                            if (String.IsNullOrWhiteSpace(profile.fileInsurancePayout))
                                InsurancePayoutFileName = "No file selected";
                            else
                                InsurancePayoutFileName = profile.fileInsurancePayout;

                            core.UpdateMessage(this, "Profile found. Loading Investments file");
                            if (String.IsNullOrWhiteSpace(profile.fileInvestments))
                                InvestmentsFileName = "No file selected";
                            else
                                InvestmentsFileName = profile.fileInvestments;

                            core.UpdateMessage(this, "Profile found. Loading Loan Repayment file");
                            if (String.IsNullOrWhiteSpace(profile.fileLoanRepayment))
                                LoanRepaymentsFileName = "No file selected";
                            else
                                LoanRepaymentsFileName = profile.fileLoanRepayment;

                            core.UpdateMessage(this, "Profile found. Loading NCR Loan file");
                            if (String.IsNullOrWhiteSpace(profile.fileNCRLoan))
                                NCRLoanFileName = "No file selected";
                            else
                                NCRLoanFileName = profile.fileNCRLoan;

                            core.UpdateMessage(this, "Profile found. Loading Private Company Dividend file");
                            if (String.IsNullOrWhiteSpace(profile.filePrivateCompanyDividend))
                                PrivateCompanyDividendFileName = "No file selected";
                            else
                                PrivateCompanyDividendFileName = profile.filePrivateCompanyDividend;

                            core.UpdateMessage(this, "Profile found. Loading Proof of Address file");
                            if (String.IsNullOrWhiteSpace(profile.fileProofOfAddress))
                                POAFileName = "No file selected";
                            else
                                POAFileName = profile.fileProofOfAddress;

                            core.UpdateMessage(this, "Profile found. Loading Retrenchment Annuity file");
                            if (String.IsNullOrWhiteSpace(profile.fileRetrenchmentAnnuity))
                                RetrenchmentAnnuityFileName = "No file selected";
                            else
                                RetrenchmentAnnuityFileName = profile.fileRetrenchmentAnnuity;

                            core.UpdateMessage(this, "Profile found. Loading Sale of Asset file");
                            if (String.IsNullOrWhiteSpace(profile.fileSaleOfAsset))
                                SaleOfAssetFileName = "No file selected";
                            else
                                SaleOfAssetFileName = profile.fileSaleOfAsset;

                            core.UpdateMessage(this, "Profile found. Loading Savings file");
                            if (String.IsNullOrWhiteSpace(profile.fileSavings))
                                SavingsFileName = "No file selected";
                            else
                                SavingsFileName = profile.fileSavings;

                            core.UpdateMessage(this, "Profile found. Loading Sole Proprietor file");
                            if (String.IsNullOrWhiteSpace(profile.fileSoleProprietor))
                                SoleProprietorFileName = "No file selected";
                            else
                                SoleProprietorFileName = profile.fileSoleProprietor;

                            core.UpdateMessage(this, "Profile found. Loading Spousal Donations file");
                            if (String.IsNullOrWhiteSpace(profile.fileSpousalDonations))
                                SpousalDonationsFileName = "No file selected";
                            else
                                SpousalDonationsFileName = profile.fileSpousalDonations;

                            core.UpdateMessage(this, "Profile found. Loading Trust Distribution file");
                            if (String.IsNullOrWhiteSpace(profile.fileTrustDistribution))
                                TrustDistributionFileName = "No file selected";
                            else
                                TrustDistributionFileName = profile.fileTrustDistribution;

                        }

                    }

                    //GenderValue = "Male";
                }
                else
                {
                    errorMessage = "Not Allowed";
                }
            }
            else
            {
                errorMessage = "User is not authenticated";
            }
        }
        else
        {
            errorMessage = "Auth State is null";
        }

        core.UpdateMessage(this, " ");
    }


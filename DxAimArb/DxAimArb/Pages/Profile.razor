    protected override async void OnInitialized()
    {
        //this updates core.Message, which we can show on any page
        //core.UpdateMessage(this, "Profile page load. Start...");
        core.UpdateMessage(this, "Loading Profile data. Please wait...");

        var authState = await authenticationStateTask;
        if (authState != null)
        {
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated == true)
            {
                //TODO restore this : boolCanView = (user.FindFirst(c => c.Type == "bAllowedProfile")?.Value.ToLower() == "true");
                if (boolCanView)
                {
                    if (!UnitOfWork.IsConnected)
                    {
                        UnitOfWork.Connect();
                    }

                    //get the size of the form


                    //TODO - always only return what this user can see
                    //orders = UnitOfWork.Query<Order>().Where(x => x.Customer.Oid == user.Identity.Oid);

                    //get a unique list of industries sorted by name
                    industries = (from Name in UnitOfWork.Query<Industry>()
                    .Select(s => s.Name)
                    .Distinct() as XPQuery<string>
                                  orderby Name ascending
                                  select Name).ToList();

                    //get or add the profile record for this user
                    FirstNamesTextValue = core.FirstName?.Replace("$", "");
                    SurnameTextValue = core.LastName?.Replace("$", "");
                    EmailTextValue = core.Email?.Replace("$", "");
                    InitialsTextValue = FirstNamesTextValue?.Substring(0, 1);

                    //get/create the Profile for this user

                    var qry = UnitOfWork.Query<Data.Profile>().Where(x => x.UserId == core.UserId);

                    if (qry == null)
                    {
                        //create one for this user
                        profile = new Data.Profile(UnitOfWork);
                        profile.UserId = core.UserId;
                        profile.FirstNames = FirstNamesTextValue;
                        profile.PreferredName = FirstNamesTextValue;
                        profile.Surname = SurnameTextValue;
                        UnitOfWork.CommitChanges();
                    }
                    else
                    {
                        //it exists. Just use it and set all text field values from the db table
                        profile = qry.FirstOrDefault();
                        //profile.Surname = SurnameTextValue;
                        //UnitOfWork.CommitChanges();




                        if (profile != null)
                        {
                            core.UpdateMessage(this, "Profile found. Loading Personal Information");
                            //1. Personal Information
                            TitleValue = profile.Title;
                            InitialsTextValue = profile.Initials;
                            FirstNamesTextValue = profile.FirstNames;
                            SurnameTextValue = profile.Surname;
                            PreferrednameTextValue = profile.PreferredName;
                            GenderValue = profile.Gender;
                            this.DateOfBirth = profile.DateOfBirth;
                            CountryName = profile.CountryOfBirth;
                            NationalityName = profile.Nationality;
                            IDNumberTextValue = profile.IDNumber;
                            TaxNumberTextValue = profile.TaxNumber;
                            DualCitizen = profile.DualCitizen;
                            ShowCountryOfLiability = profile.DualCitizen;
                            if (profile.DualCitizen)
                                YesNoSelected = "Yes";
                            else
                                YesNoSelected = "No";
                            YesNoValue = YesNoSelected;

                            core.UpdateMessage(this, "Profile found. Loading Contact Details");
                            //2. Contact details
                            EmailTextValue = profile.Email;
                            MobilePhoneTextValue = profile.MobilePhoneNumber;

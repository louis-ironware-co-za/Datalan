@*@page "/profile"*@
@page "/"
@using DevExpress.Xpo.DB
@using DxAimArb.Data

@inject IJSRuntime JsRuntime
@inject Core core
@inject UnitOfWork UnitOfWork
@inject NavigationManager NavigationManager
@inject TokenProvider TokenProvider
@inject IJSRuntime JS


 <PageTitle>AIM Arbitrage (rc 1.3) - Profile</PageTitle>


@if (boolCanView)
{
    <AuthorizeView>

        <Authorized Context="auth">
            <DxFormLayout CaptionPosition="CaptionPosition.Horizontal" CssClass="w-100">
                <blueheader>Please ensure the below information and documents are correct</blueheader>
            </DxFormLayout>
            @*1. Personal Information*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="1. Personal Information"
                               ColSpanXs="9"
                               ColSpanSm="9"
                               ColSpanMd="9"
                               ColSpanLg="9"
                               ColSpanXl="9"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            PERSONAL INFORMATION
                        </div>
                        <div class="my-style-right">
                             <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Save" @onclick="SavePersonalInfo" CssClass="w-100" />
                        </div>
                    </HeaderTemplate>
                    <Items>
                   
                    <DxFormLayoutItem Caption="Title" ColSpanLg="2" ColSpanMd="2" CaptionCssClass="required-caption">
                        <DxComboBox Data="@titles"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@TitleSelected"
                                @bind-Text="@TitleValue"
                                AllowUserInput="true"
                                NullText="Select"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Initials" ColSpanLg="2" ColSpanMd="2" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@InitialsTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="Enter Initials"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="First Names" ColSpanLg="5" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@FirstNamesTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="Enter your full First Names as per your Identity Document"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Surname" ColSpanLg="3" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@SurnameTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="Enter your Surname as per your Identity Document"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Preferred name" ColSpanLg="4" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@PreferrednameTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               NullText="What do your friends call you?"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Gender" ColSpanLg="2" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxComboBox Data="@genders"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@GenderSelected"
                                @bind-Text="@GenderValue"
                                AllowUserInput="true"
                                NullText="Select"
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date of Birth" ColSpanLg="6" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxDateEdit @bind-Date="@DateOfBirth"
                                DisplayFormat="dddd, dd MMMM yyyy"
                                CssClass="cw-320" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Country of Birth" ColSpanLg="6" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                        <DxComboBox Data="@countries_birth"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@CountryValue"
                                @bind-Text="@CountryName"
                                AllowUserInput="false"
                                NullText="Select Country ..."
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Nationality" ColSpanLg="6" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxComboBox Data="@countries_nationality"
                                ListRenderMode="ListRenderMode.Virtual"
                                @bind-Value="@NationalityValue"
                                @bind-Text="@NationalityName"
                                AllowUserInput="false"
                                NullText="Select Country ..."
                                FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="ID Number" ColSpanLg="6" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@IDNumberTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               CssClass="cw-320" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Tax Number" ColSpanLg="6" ColSpanMd="3" CaptionCssClass="required-caption">
                        <DxTextBox @bind-Text="@TaxNumberTextValue"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               BindValueMode="BindValueMode.OnInput"
                               CssClass="cw-320" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Dual Citizenship" ColSpanLg="3" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption" CssClass="cw-320">
                            @* <DxCheckBox CheckedChanged="@((bool t) => DualCitizenChanged(t))"
                        CssClass="w-100"
                        LabelPosition="LabelPosition.Left"
                        Checked="@DualCitizen">I have Tax Liability in another country</DxCheckBox>*@
                            <DxComboBox Data="@yesno"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Text="@YesNoValue"
                                    AllowUserInput="false"
                                    NullText="Select"
                                    ValueChanged="@((string YesNoValue) => SelectedDualCitizenChanged(YesNoValue))"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Country of Tax Liability" 
                            ColSpanLg="6" 
                            ColSpanMd="3" 
                            Visible="@ShowCountryOfLiability"
                            CaptionCssClass="required-caption">
                            <DxComboBox Data="@countries_nationality"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@TaxLiabilityValue"
                                    @bind-Text="@TaxLiabilityName"
                                    AllowUserInput="false"
                                    NullText="Select Country ..."
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*2. Contact Details*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="2. Contact Details"
                               ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            CONTACT DETAILS
                        </div>
                        <div class="my-style-right">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Save" @onclick="SaveContactDetails" CssClass="w-100" />
                        </div>
                    </HeaderTemplate>
                    <Items>
                       <DxFormLayoutItem Caption="Email" ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">

                            <DxTextBox @bind-Text="@EmailTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Enter a valid email address"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Mobile Number" ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">
                            <DxMaskedInput @bind-Value="@MobilePhoneTextValue"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                       BindValueMode="BindValueMode.OnInput"
                                       Mask="+00 00 000 0000"
                                       NullText="Enter a valid mobile phone number"
                                       CssClass="cw-320"></DxMaskedInput>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Address" ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@AddressLine1TextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Address Line 1"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanLg="12" ColSpanMd="12" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@AddressLine2TextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Address Line 2"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanLg="8" ColSpanMd="8" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@CityTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="City"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@PostalCodeTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Postal Code"
                                   CssClass="cw-320"> </DxTextBox>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@ProvinceTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Province"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">
                            <DxComboBox Data="@countries"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@AddressCountryTextValue"
                                    @bind-Text="@AddressCountryName"
                                    AllowUserInput="false"
                                    NullText="Select Country ..."
                                    FilteringMode="DataGridFilteringMode.Contains"> </DxComboBox>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*3. Work Information*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup 
                    ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            WORK INFORMATION  &nbsp  &nbsp
                        </div>
                         <div class="my-style">
                                <DxCheckBox CheckedChanged="@((bool t) => UnemployedChanged(t))"
                                        LabelPosition="LabelPosition.Right"
                                        Checked="@Unemployed">Unemployed</DxCheckBox>
                            </div>
                           
                            <div class="my-style-right">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Save" @onclick="SaveWorkInformation" CssClass="w-100" />
                        </div>
                    </HeaderTemplate>
                    <Items>
                        <DxFormLayoutItem Caption="Employer Name" ColSpanLg="3" ColSpanMd="3" BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@EmployerNameTextValue"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   CssClass="cw-320"></DxTextBox>
                           @* <div class="my-style-right">
                                <DxCheckBox CheckedChanged="@((bool t) => UnemployedChanged(t))"
                                        LabelPosition="LabelPosition.Left"
                                        Checked="@Unemployed">Unemployed</DxCheckBox>

                            </div>*@
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Employer Industry"
                                      ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="6"
                                      ColSpanLg="6"
                                      ColSpanXl="6"
                                      BeginRow="true" CaptionCssClass="required-caption">
                            <DxComboBox Data="@industries"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@IndustrySelected"
                                    @bind-Text="@IndustryValue"
                                    AllowUserInput="true"
                                    NullText="Select Industry"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                         <DxFormLayoutItem Caption="Occupation" 
                                      ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="6"
                                      ColSpanLg="6"
                                      ColSpanXl="6"
                             BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@Occupation"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Job Title" 
                                      ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="6"
                                      ColSpanLg="6"
                                      ColSpanXl="6"
                            BeginRow="true" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@Designation"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   CssClass="cw-320"></DxTextBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Monthly Income" 
                                      ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="6"
                                      ColSpanLg="6"
                                      ColSpanXl="6"
                            BeginRow="true" CaptionCssClass="required-caption">
                            <DxComboBox Data="@income"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@IncomeSelected"
                                    @bind-Text="@IncomeValue"
                                    AllowUserInput="true"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*4. Funding Account*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="4. Funding Account"
                               ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            FUNDING ACCOUNT
                        </div>
                        <div class="my-style-right">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Save" @onclick="SaveFundingDetails" CssClass="w-100" />
                        </div>

                    </HeaderTemplate>
                    <Items>
                        <DxFormLayoutItem 
                            Context="ctxfundingaccount"
                                      ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="12"
                                      ColSpanLg="12"
                                      ColSpanXl="12">
                            <DxMemo @bind-Text="@FundingAccountLabel"
                                CssClass="w-100a50"
                                Rows="2"
                                ResizeMode="MemoResizeMode.Disabled"
                                ReadOnly="true"></DxMemo>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Bank Name" ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption" BeginRow="true">
                            <DxComboBox Data="@banks"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@BankValue"
                                    @bind-Text="@BankName"
                                    AllowUserInput="false"
                                    NullText="Select your bank"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Account Number" ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption">
                            <DxTextBox @bind-Text="@AccountNumber"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   BindValueMode="BindValueMode.OnInput"
                                   CssClass="cw-320" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Account Type" ColSpanLg="4" ColSpanMd="4" CaptionCssClass="required-caption">
                            <DxComboBox Data="@bankaccounttypes"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@AccountTypeValue"
                                    @bind-Text="@AccountTypeName"
                                    AllowUserInput="false"
                                    NullText="Select Account Type"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Trade Size (R100k min)" ColSpanLg="6" ColSpanMd="6" BeginRow="true" CaptionCssClass="required-caption">
                            <DxSpinEdit @bind-Value="@TradeSizeValue"
                                    MinValue="100000"
                                    Increment="1000"
                                    BindValueMode="BindValueMode.OnInput"
                                    Mask="@NumericMask.Currency" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Anticipated Volume" ColSpanLg="6" ColSpanMd="6" CaptionCssClass="required-caption">
                            <DxSpinEdit @bind-Value="@AnticipatedVolumeValue"
                                    MinValue="100000"
                                    Increment="1000"
                                    BindValueMode="BindValueMode.OnInput"
                                    Mask="@NumericMask.Currency" />
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*5. Identity Document*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="5. ID Document"
                               ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            ID DOCUMENT
                        </div>
                    </HeaderTemplate>
                    <Items>
                        <DxFormLayoutItem
                           ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12">
                            <DxMemo @bind-Text="@IDDocumentLabel"
                                CssClass="w-100a50"
                                Rows="2"
                                ResizeMode="MemoResizeMode.Disabled"
                                ReadOnly="true"></DxMemo>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanXs="6"
                                      ColSpanSm="6"
                                      ColSpanMd="3"
                                      ColSpanLg="3"
                                      ColSpanXl="3" 
                                      BeginRow="true">
                            <DxComboBox Data="@iddocuments"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@IDTypeValue"
                                    @bind-Text="@IDTypeName"
                                    AllowUserInput="false"
                                    NullText="Select ID Type"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                        @*//file uploads === 6 ==============================================================*@
                        <DxUpload Name="file" FileUploaded="@OnIdDocumentFileNameUploaded" UploadUrl="api/upload/UploadIdDocument/"></DxUpload>
                        <DxFormLayoutItem ColSpanLg="10" ColSpanMd="10">
                            <bluelabel>@IdDocumentFileName</bluelabel>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*6. Selfie with ID*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            SELFIE WITH YOUR ID
                        </div>
                    </HeaderTemplate>
                    <Items>
                            <DxFormLayoutItem 
                                Context="ctxselfiewithidlabel"
                                ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="12"
                                      ColSpanLg="12"
                                      ColSpanXl="12">
                            <DxMemo @bind-Text="@SelfieWithIDLabel"
                                CssClass="w-100a50"
                                Rows="3"
                                ResizeMode="MemoResizeMode.Disabled"
                                ReadOnly="true"></DxMemo>
                        </DxFormLayoutItem>
                        @*//file uploads === 6 ==============================================================*@
                        <DxUpload Name="file" FileUploaded="@OnSWIDUploaded" UploadUrl="api/upload/UploadSelfieWithID/"></DxUpload>
                        <DxFormLayoutItem ColSpanLg="10" ColSpanMd="10">
                            <bluelabel>@SelfieWithIDFileName</bluelabel>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*7. Proof of Address*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            PROOF OF ADDRESS
                        </div>
                    </HeaderTemplate>
                    <Items>
                            <DxFormLayoutItem 
                                Context="ctxpoa"
                                ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="12"
                                      ColSpanLg="12"
                                      ColSpanXl="12">
                            <DxMemo @bind-Text="@ProofOfAddressLabel"
                                CssClass="w-100a50"
                                Rows="3"
                                ResizeMode="MemoResizeMode.Disabled"
                                ReadOnly="true"></DxMemo>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem ColSpanXs="6"
                                      ColSpanSm="6"
                                      ColSpanMd="6"
                                      ColSpanLg="6"
                                      ColSpanXl="6"
                                      BeginRow="true">
                            <DxComboBox Data="@POAdoctypes"
                                    ListRenderMode="ListRenderMode.Virtual"
                                    @bind-Value="@POATypeValue"
                                    @bind-Text="@POATypeName"
                                    AllowUserInput="false"
                                    NullText="Select POA Type"
                                    FilteringMode="DataGridFilteringMode.Contains"></DxComboBox>
                        </DxFormLayoutItem>
                        @*//file uploads === 6 ==============================================================*@
                        <DxUpload Name="file" FileUploaded="@OnPOAUploaded" UploadUrl="api/upload/UploadProofOfAddress/"></DxUpload>
                        <DxFormLayoutItem ColSpanLg="10" ColSpanMd="10">
                            <bluelabel>@POAFileName</bluelabel>
                        </DxFormLayoutItem>
                    </Items>
                </DxFormLayoutGroup>
            </DxFormLayout>

            @*8. Source of funds*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup 
                               ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
                               ColSpanLg="12"
                               ColSpanXl="12"
                               CssClass="w-100a50">
                    <HeaderTemplate>
                        <div class="my-style">
                            SOURCE OF FUNDS
                        </div>
                    </HeaderTemplate>
                    <Items>
                            <DxFormLayoutItem 
                                Context="ctxsof"
                                ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="12"
                                      ColSpanLg="12"
                                      ColSpanXl="12">
                            <DxMemo @bind-Text="@SourceOfFundsLabel"
                                CssClass="w-100a50"
                                Rows="2"
                                ResizeMode="MemoResizeMode.Disabled"
                                ReadOnly="true"></DxMemo>
                        </DxFormLayoutItem>
                        <DxUpload Name="file" FileUploaded="@OnChequeAccountStatementFilenameUploaded" UploadUrl="api/upload/UploadChequeAccount/"></DxUpload>
                        <DxFormLayoutItem ColSpanLg="9" ColSpanMd="9" Caption=" ">
                            <bluelabel>@ChequeAccountStatementFilename</bluelabel>
                        </DxFormLayoutItem>

                            <DxFormLayoutItem 
                                Context="ctxchq"
                                ColSpanXs="12"
                                      ColSpanSm="12"
                                      ColSpanMd="12"
                                      ColSpanLg="12"
                                      ColSpanXl="12">
                            <DxMemo @bind-Text="@ChequeAccountLabel"
                                CssClass="w-100a50"
                                Rows="2"
                                ResizeMode="MemoResizeMode.Disabled"
                                ReadOnly="true"></DxMemo>
                        </DxFormLayoutItem>

                    </Items>


                </DxFormLayoutGroup>


            </DxFormLayout>

            @*8. Additional Source of Funds*@
            <DxFormLayout CaptionPosition="CaptionPosition.Vertical" CssClass="w-100">
                <DxFormLayoutGroup Caption="@additionalsof"
                               ColSpanXs="12"
                               ColSpanSm="12"
                               ColSpanMd="12"
